# Port serwera gry (Vite w trybie dev przekierowuje /api i /socket.io na ten port)
PORT=3001

# Clerk — opcjonalne. Bez tych kluczy gra działa tylko w trybie gościa.
# Klucze znajdziesz w https://dashboard.clerk.com → API keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Opcjonalnie: dozwolone originy tokenów, np. https://krec-i-zgaduj.onrender.com
CLERK_AUTHORIZED_PARTIES=
